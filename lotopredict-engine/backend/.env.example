# =====================================================================
# LotoPredict Engine — Variáveis de Ambiente do Backend
# Copie este arquivo para .env e preencha os valores reais
# NUNCA commite o .env real no repositório (está no .gitignore)
# =====================================================================

# --- Banco de Dados ---
# Desenvolvimento local: SQLite (padrão automático, não precisa configurar)
# Produção (Render / Railway): PostgreSQL completo
# Exemplo Render PostgreSQL:
# POSTGRES_URL=postgresql://user:password@oregon-postgres.render.com:5432/lotopredict_db

POSTGRES_URL=

# --- Configurações da Aplicação ---
DEBUG=false

# --- Frontend (usado pelo CORS) ---
# URL do seu frontend Vercel em produção
FRONTEND_URL=https://frontend-delta-six-13.vercel.app
